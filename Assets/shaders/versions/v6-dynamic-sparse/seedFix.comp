#version 430 core
layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Runs after classify, one invocation per scratch voxel.
// classify only seeds voxels with |d| < voxel diagonal. SDFs that aren't exact distances (terrain returns the
// vertical distance p.y - h) overestimate on steep slopes, so a surface can pass between two voxels that both fail
// that test. Then no seed marks the crossing, the distances around it come from seeds further away, and the march
// oversteps thin ridges. Here every voxel whose sign differs from a face neighbour's gets a seed if it has none,
// placed where the SDF crosses zero along that edge (linear interpolation, which doesn't need an exact distance).
layout(rgba16f, binding = 0) uniform image3D seeds; // chunk-local, read and written in place (own voxel only)
layout(r8, binding = 1) uniform readonly image3D signTex;
layout(r16f, binding = 2) uniform readonly image3D distTex;
layout(r8, binding = 3) uniform writeonly image3D brickFlagsOut;

uniform vec3 _ChunkDim;
uniform vec3 _ChunkVoxelOrigin;
uniform vec3 _FlagOrigin;
uniform vec3 _FlagDim;
uniform int BRICK_CORE;

void main() {
    ivec3 v = ivec3(gl_GlobalInvocationID);
    ivec3 dim = ivec3(_ChunkDim);
    if (any(greaterThanEqual(v, dim))) return;
    if (imageLoad(seeds, v).w > 0.5) return; // classify already seeded it

    bool inside = imageLoad(signTex, v).r > 0.5;
    float d0 = imageLoad(distTex, v).r;

    float bestT = 2.0;
    vec3 bestDir = vec3(0.0);
    for (int i = 0; i < 6; i++) {
        ivec3 dir = ivec3(0);
        dir[i >> 1] = (i & 1) == 0 ? 1 : -1;
        ivec3 n = v + dir;
        if (any(lessThan(n, ivec3(0))) || any(greaterThanEqual(n, dim))) continue;
        if ((imageLoad(signTex, n).r > 0.5) == inside) continue;

        float d1 = imageLoad(distTex, n).r;
        float t = (d0 != d1) ? clamp(d0 / (d0 - d1), 0.0, 1.0) : 0.5;
        if (t < bestT) { bestT = t; bestDir = vec3(dir); }
    }
    if (bestT > 1.0) return; // no sign change around this voxel

    imageStore(seeds, v, vec4(vec3(v) + bestDir * bestT, 1.0));

    ivec3 flag = (v + ivec3(_ChunkVoxelOrigin)) / BRICK_CORE - ivec3(_FlagOrigin);
    if (all(greaterThanEqual(flag, ivec3(0))) && all(lessThan(flag, ivec3(_FlagDim))))
        imageStore(brickFlagsOut, flag, vec4(1.0));
}
