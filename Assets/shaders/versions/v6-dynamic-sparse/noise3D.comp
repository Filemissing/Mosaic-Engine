#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(r16f, binding = 0) uniform writeonly image3D noiseOut;

uniform vec3 _Resolution;
uniform int _Seed;

// Must match NOISE3D_TEXELS_PER_CELL in classify.comp. The cell size in texels is fixed, so a larger texture holds
// more cells (it repeats less often) instead of the same cells sampled more finely.
const float TEXELS_PER_CELL = 4.0;

// pcg3d — integer hash, no float precision loss for large seeds or coordinates
uvec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}

vec3 gradient(ivec3 cell, ivec3 period) {
    ivec3 wrapped = ((cell % period) + period) % period; // tileable: the texture wraps with GL_REPEAT
    uvec3 h = pcg3d(uvec3(wrapped) + uvec3(0u, 0u, uint(_Seed) * 1024u));
    // uniformly distributed unit vector
    float z = float(h.x) * (2.0 / 4294967296.0) - 1.0;
    float angle = float(h.y) * (6.28318530718 / 4294967296.0);
    float r = sqrt(max(0.0, 1.0 - z * z));
    return vec3(r * cos(angle), r * sin(angle), z);
}

// gradient (Perlin) noise with a quintic fade: no axis-aligned box pattern like value noise
float perlin3D(vec3 p, ivec3 period) {
    ivec3 i = ivec3(floor(p));
    vec3 f = fract(p);
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);

    float n000 = dot(gradient(i + ivec3(0, 0, 0), period), f - vec3(0, 0, 0));
    float n100 = dot(gradient(i + ivec3(1, 0, 0), period), f - vec3(1, 0, 0));
    float n010 = dot(gradient(i + ivec3(0, 1, 0), period), f - vec3(0, 1, 0));
    float n110 = dot(gradient(i + ivec3(1, 1, 0), period), f - vec3(1, 1, 0));
    float n001 = dot(gradient(i + ivec3(0, 0, 1), period), f - vec3(0, 0, 1));
    float n101 = dot(gradient(i + ivec3(1, 0, 1), period), f - vec3(1, 0, 1));
    float n011 = dot(gradient(i + ivec3(0, 1, 1), period), f - vec3(0, 1, 1));
    float n111 = dot(gradient(i + ivec3(1, 1, 1), period), f - vec3(1, 1, 1));

    return mix(
        mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
        mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y),
        u.z);
}

void main()
{
    ivec3 texel = ivec3(gl_GlobalInvocationID);

    // bounds check
    if (any(greaterThanEqual(texel, _Resolution)))
    return;

    ivec3 cells = max(ivec3(round(_Resolution / TEXELS_PER_CELL)), ivec3(1));
    vec3 uv = (vec3(texel) + 0.5) / _Resolution;

    // 3D Perlin lies within about +-0.866, remap to [0, 1] like the value noise it replaces
    float value = clamp(perlin3D(uv * vec3(cells), cells) * 0.5774 + 0.5, 0.0, 1.0);

    imageStore(noiseOut, texel, vec4(value));
}
