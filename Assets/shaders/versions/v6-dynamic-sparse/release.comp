#version 430 core
layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// returns the pool slots of the dirty bricks in a box to the free list, before they're re-allocated
layout(r8, binding = 0) uniform readonly image3D dirtyTex;
layout(rgba32f, binding = 1) uniform readonly image3D lookupTex;

layout(std430, binding = 1) buffer FreeList {
    int freeCount;
    int droppedBricks;
    uint freeSlots[];
};

uniform vec3 _BoxMin;
uniform vec3 _BoxDim;
uniform vec3 _PoolGridDim;
uniform int BRICK_STORE;

void main() {
    ivec3 i = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(i, ivec3(_BoxDim)))) return;
    ivec3 brick = ivec3(_BoxMin) + i;

    if (imageLoad(dirtyTex, brick).r < 0.5) return;
    vec4 lookup = imageLoad(lookupTex, brick);
    if (lookup.w < 0.5) return; // no slot to give back

    ivec3 poolBrick = ivec3(lookup.xyz) / BRICK_STORE;
    ivec3 dim = ivec3(_PoolGridDim);
    uint slot = uint(poolBrick.x + poolBrick.y * dim.x + poolBrick.z * dim.x * dim.y);

    int idx = atomicAdd(freeCount, 1);
    freeSlots[idx] = slot;
}
