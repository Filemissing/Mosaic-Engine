#version 430 core
layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// one invocation per brick of the box being rebaked; only dirty bricks are touched
layout(r8, binding = 0) uniform readonly image3D brickFlags; // chunk-local, 1 = brick contains a seed
layout(rgba32f, binding = 1) uniform writeonly image3D lookupOut;
layout(r8, binding = 2) uniform readonly image3D dirtyTex;
layout(r8, binding = 3) uniform readonly image3D brickSignTex;

layout(std430, binding = 1) buffer FreeList {
    int freeCount;
    int droppedBricks;
    uint freeSlots[];
};

uniform vec3 _BoxMin;
uniform vec3 _BoxDim;
uniform vec3 _FlagOrigin;
uniform vec3 _PoolGridDim;
uniform int BRICK_STORE;

// out-of-range image loads return 0, so bricks at the edge of the flag volume simply count as "no seed"
float isActive(ivec3 f) {
    return imageLoad(brickFlags, f).r +
    imageLoad(brickFlags, f + ivec3(1, 0, 0)).r +
    imageLoad(brickFlags, f + ivec3(-1, 0, 0)).r +
    imageLoad(brickFlags, f + ivec3(0, 1, 0)).r +
    imageLoad(brickFlags, f + ivec3(0, -1, 0)).r +
    imageLoad(brickFlags, f + ivec3(0, 0, 1)).r +
    imageLoad(brickFlags, f + ivec3(0, 0, -1)).r;
}

void main() {
    ivec3 i = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(i, ivec3(_BoxDim)))) return;
    ivec3 brickIndex = ivec3(_BoxMin) + i;

    if (imageLoad(dirtyTex, brickIndex).r < 0.5) return; // untouched brick keeps its slot and data

    if (isActive(brickIndex - ivec3(_FlagOrigin)) < 0.5) {
        float brickSign = imageLoad(brickSignTex, brickIndex).r;
        float w = (brickSign > 0.5) ? -1.0 : 0.0; // solid : empty
        imageStore(lookupOut, brickIndex, vec4(0.0, 0.0, 0.0, w));
        return;
    }

    // pop a slot; on underflow undo the decrement (it only ever undoes this invocation's own -1, so the count
    // can't rise above the real number of free slots)
    int old = atomicAdd(freeCount, -1);
    if (old <= 0) {
        atomicAdd(freeCount, 1);
        atomicAdd(droppedBricks, 1);
        imageStore(lookupOut, brickIndex, vec4(0.0)); // pool full — rendered as empty
        return;
    }
    uint slot = freeSlots[old - 1];

    ivec3 poolGridDim = ivec3(_PoolGridDim);
    ivec3 poolBrickCoord = ivec3(
        int(slot) % poolGridDim.x,
        (int(slot) / poolGridDim.x) % poolGridDim.y,
        int(slot) / (poolGridDim.x * poolGridDim.y)
    );
    imageStore(lookupOut, brickIndex, vec4(vec3(poolBrickCoord * BRICK_STORE), 1.0));
}
