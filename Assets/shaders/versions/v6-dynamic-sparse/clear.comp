#version 430 core
layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// fills a box of an R8 volume with one value — used to stamp/clear dirty bricks and to reset brickFlags
// (glClearTexSubImage would do the same, but needs GL 4.4 and the context is 4.3)
layout(r8, binding = 0) uniform writeonly image3D target;

uniform vec3 _Origin;
uniform vec3 _Dim;
uniform float _Value;

void main() {
    ivec3 i = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(i, ivec3(_Dim)))) return;
    imageStore(target, ivec3(_Origin) + i, vec4(_Value));
}
